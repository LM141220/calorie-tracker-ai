NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required: use the URL and anon key from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Configure at least one provider to enable meal analysis.
# These are server-side secrets; never use the NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional signup notifications. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APPROVAL_NOTIFICATION_EMAIL=

# Optional performance logging (mainly useful in production).
PERF_LOGS=false
NEXT_PUBLIC_PERF_LOGS=false
